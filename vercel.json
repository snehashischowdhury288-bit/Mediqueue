{
  "buildCommand": "cd frontend-react && npm install && npm run build",
  "outputDirectory": "frontend-react/dist",
  "rewrites": [
    { "source": "/api/gmail/send", "destination": "/api/gmail" },
    { "source": "/api/mailtrap/send", "destination": "/api/mailtrap" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}

